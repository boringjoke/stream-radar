<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotchpotch.radarbackend.domain.mapper.UserFollowAnchorMapper">

    <resultMap id="BaseResultMap" type="com.hotchpotch.radarbackend.domain.entity.UserFollowAnchor">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="anchor_id" property="anchorId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        id,
        user_id,
        anchor_id,
        create_time,
        update_time
    </sql>

    <select id="selectByUserIdAndAnchorId" resultMap="BaseResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM user_follow_anchor
        WHERE user_id = #{userId}
          AND anchor_id = #{anchorId}
        LIMIT 1
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM user_follow_anchor
        WHERE user_id = #{userId}
        ORDER BY create_time DESC, id DESC
    </select>

</mapper>
