<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotchpotch.radarbackend.domain.mapper.UserFollowAnchorMapper">

    <resultMap id="BaseResultMap" type="com.hotchpotch.radarbackend.domain.entity.UserFollowAnchor">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="anchor_id" property="anchorId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        id,
        user_id,
        anchor_id,
        create_time,
        update_time
    </sql>

    <select id="selectByUserIdAndAnchorId" resultMap="BaseResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM user_follow_anchor
        WHERE user_id = #{userId}
          AND anchor_id = #{anchorId}
        LIMIT 1
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM user_follow_anchor
        WHERE user_id = #{userId}
        ORDER BY create_time DESC, id DESC
    </select>

    <resultMap id="LiveAnchorCardResultMap" type="com.hotchpotch.radarbackend.vo.live.LiveAnchorCardVO">
        <id column="follow_id" property="followId"/>
        <result column="anchor_id" property="anchorId"/>
        <result column="platform" property="platform"/>
        <result column="room_id" property="roomId"/>
        <result column="platform_uid" property="platformUid"/>
        <result column="room_url" property="roomUrl"/>
        <result column="anchor_name" property="anchorName"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="live_title" property="liveTitle"/>
        <result column="online_count" property="onlineCount"/>
        <result column="live_status" property="liveStatus"/>
        <result column="last_check_time" property="lastCheckTime"/>
    </resultMap>

    <select id="selectLiveAnchorCardsByUserId" resultMap="LiveAnchorCardResultMap">
        SELECT
            ufa.id AS follow_id,
            la.id AS anchor_id,
            la.platform,
            la.room_id,
            la.platform_uid,
            la.room_url,
            la.anchor_name,
            la.avatar_url,
            la.cover_url,
            la.live_title,
            la.online_count,
            la.live_status,
            la.last_check_time
        FROM user_follow_anchor ufa
        INNER JOIN live_anchor la ON la.id = ufa.anchor_id
        WHERE ufa.user_id = #{userId}
        ORDER BY ufa.create_time ASC, ufa.id ASC
    </select>

    <select id="countByUserId" resultType="long">
        SELECT COUNT(*)
        FROM user_follow_anchor
        WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserIdAndId">
        DELETE FROM user_follow_anchor
        WHERE user_id = #{userId}
          AND id = #{followId}
    </delete>

    <delete id="deleteByUserIdAndIds">
        DELETE FROM user_follow_anchor
        WHERE user_id = #{userId}
          AND id IN
        <foreach collection="followIds" item="followId" open="(" separator="," close=")">
            #{followId}
        </foreach>
    </delete>

</mapper>
