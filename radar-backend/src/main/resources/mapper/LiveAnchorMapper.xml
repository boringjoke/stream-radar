<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotchpotch.radarbackend.domain.mapper.LiveAnchorMapper">

    <resultMap id="BaseResultMap" type="com.hotchpotch.radarbackend.domain.entity.LiveAnchor">
        <id column="id" property="id"/>
        <result column="platform" property="platform"/>
        <result column="room_id" property="roomId"/>
        <result column="platform_uid" property="platformUid"/>
        <result column="room_url" property="roomUrl"/>
        <result column="anchor_name" property="anchorName"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="live_title" property="liveTitle"/>
        <result column="online_count" property="onlineCount"/>
        <result column="live_status" property="liveStatus"/>
        <result column="failure_count" property="failureCount"/>
        <result column="error_message" property="errorMessage"/>
        <result column="last_check_time" property="lastCheckTime"/>
        <result column="last_success_time" property="lastSuccessTime"/>
        <result column="status_change_time" property="statusChangeTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        id,
        platform,
        room_id,
        platform_uid,
        room_url,
        anchor_name,
        avatar_url,
        cover_url,
        live_title,
        online_count,
        live_status,
        failure_count,
        error_message,
        last_check_time,
        last_success_time,
        status_change_time,
        create_time,
        update_time
    </sql>

    <select id="selectByPlatformAndRoomId" resultMap="BaseResultMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM live_anchor
        WHERE platform = #{platform}
          AND room_id = #{roomId}
        LIMIT 1
    </select>

    <resultMap id="AdminLiveAnchorResultMap" type="com.hotchpotch.radarbackend.vo.admin.AdminLiveAnchorVO">
        <id column="anchor_id" property="anchorId"/>
        <result column="platform" property="platform"/>
        <result column="room_id" property="roomId"/>
        <result column="room_url" property="roomUrl"/>
        <result column="anchor_name" property="anchorName"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="follower_count" property="followerCount"/>
    </resultMap>

    <resultMap id="AdminAnchorStatisticRowResultMap" type="com.hotchpotch.radarbackend.vo.admin.AdminAnchorStatisticRow">
        <result column="platform" property="platform"/>
        <result column="room_id" property="roomId"/>
        <result column="follower_count" property="followerCount"/>
    </resultMap>

    <sql id="AdminFollowerCountJoin">
        LEFT JOIN (
            SELECT
                ufa.anchor_id,
                COUNT(DISTINCT ufa.user_id) AS follower_count
            FROM user_follow_anchor ufa
            INNER JOIN sys_user su
                ON su.id = ufa.user_id
                AND su.status = 1
                AND su.role = 'USER'
            GROUP BY ufa.anchor_id
        ) follower_stat ON follower_stat.anchor_id = la.id
    </sql>

    <sql id="AdminAnchorPageConditions">
        <if test="platform != null and platform != ''">
            AND la.platform = #{platform}
        </if>
        <if test="anchorName != null and anchorName != ''">
            AND la.anchor_name LIKE CONCAT('%', #{anchorName}, '%')
        </if>
        <if test="roomId != null and roomId != ''">
            AND la.room_id = #{roomId}
        </if>
        <if test="minFollowerCount != null">
            AND COALESCE(follower_stat.follower_count, 0) &gt;= #{minFollowerCount}
        </if>
        <if test="maxFollowerCount != null">
            AND COALESCE(follower_stat.follower_count, 0) &lt;= #{maxFollowerCount}
        </if>
    </sql>

    <select id="selectAdminLiveAnchorPage" resultMap="AdminLiveAnchorResultMap">
        SELECT
            la.id AS anchor_id,
            la.platform,
            la.room_id,
            la.room_url,
            la.anchor_name,
            la.avatar_url,
            COALESCE(follower_stat.follower_count, 0) AS follower_count
        FROM live_anchor la
        <include refid="AdminFollowerCountJoin"/>
        WHERE 1 = 1
        <include refid="AdminAnchorPageConditions"/>
        ORDER BY
            CASE WHEN la.anchor_name IS NULL OR la.anchor_name = '' THEN 1 ELSE 0 END ASC,
            LEFT(la.anchor_name, 1) ASC,
            la.anchor_name ASC,
            la.id ASC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countAdminLiveAnchors" resultType="long">
        SELECT COUNT(*)
        FROM live_anchor la
        <include refid="AdminFollowerCountJoin"/>
        WHERE 1 = 1
        <include refid="AdminAnchorPageConditions"/>
    </select>

    <select id="selectAdminAnchorStatisticRows" resultMap="AdminAnchorStatisticRowResultMap">
        SELECT
            la.platform,
            la.room_id,
            COALESCE(follower_stat.follower_count, 0) AS follower_count
        FROM live_anchor la
        <include refid="AdminFollowerCountJoin"/>
        ORDER BY la.id ASC
    </select>

    <select id="selectMonitoredLiveAnchors" resultMap="BaseResultMap">
        SELECT
        la.id,
        la.platform,
        la.room_id,
        la.platform_uid,
        la.room_url,
        la.anchor_name,
        la.avatar_url,
        la.cover_url,
        la.live_title,
        la.online_count,
        la.live_status,
        la.failure_count,
        la.error_message,
        la.last_check_time,
        la.last_success_time,
        la.status_change_time,
        la.create_time,
        la.update_time
        FROM live_anchor la
        WHERE EXISTS (
            SELECT 1
            FROM user_follow_anchor ufa
            INNER JOIN sys_user su
                ON su.id = ufa.user_id
            WHERE ufa.anchor_id = la.id
                AND su.status = 1
        )
        ORDER BY la.id ASC;
    </select>

</mapper>
